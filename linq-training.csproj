<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>linq_training</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Exclude exercise and solution files to avoid multiple top-level statements conflict -->
  <ItemGroup>
    <Compile Remove="src/Exercises/*.cs" />
    <Compile Remove="src/Solutions/*.cs" />
  </ItemGroup>

</Project>
